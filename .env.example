# Application Environment Configuration

# Database
DATABASE_URL="postgresql://anupalan:anupalan_dev_password@localhost:5432/anupalan?schema=public"

# Timezone & Clock
APP_TIMEZONE="Asia/Kolkata"

# Object Storage (MinIO / S3)
S3_ENDPOINT="http://localhost:9000"
S3_PORT=9000
S3_ACCESS_KEY="anupalan_minio"
S3_SECRET_KEY="anupalan_minio_secret"
S3_BUCKET="anupalan-documents"
S3_USE_SSL=false

# Email (MailHog in dev)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@anupalan.nic.in"

# JWT Authentication
JWT_SECRET="anupalan-dev-jwt-super-secret-key-32chars-min"
JWT_EXPIRES_IN="1d"

# Ports
API_PORT=4000
WEB_PORT=3000
